# FaZe Blackbox — copy to .env.local for local dev, or set in Vercel.
# The app plays FULLY without these (demo-local mode: two tabs, BroadcastChannel).
# Set them to enable Supabase Realtime + server-side validation.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# NEVER put SUPABASE_SERVICE_ROLE_KEY in the frontend / .env.local / Vercel
# frontend env. It lives ONLY in Supabase Edge Function secrets.
